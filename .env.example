GEMINI_API_KEY=your_key_here
# optional, defaults to gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

CLAUDE_API_KEY=your_key_here
# optional, defaults to claude-haiku-4-5-20251001 - set to claude-sonnet-5
# for better persona/tone quality at a higher per-message cost
# CLAUDE_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=your_key_here
# optional, defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Provider picked automatically by app/llm.py's _provider(): OpenAI first if
# its key is set, then Claude, then Gemini. Remove/comment out whichever
# key(s) you don't want active right now rather than editing code.
